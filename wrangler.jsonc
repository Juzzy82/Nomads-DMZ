{
  // NOMADS DMZ HUB - Cloudflare Worker (website files + patch notes tracker)
  "name": "nomads-dmz",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  // Checks the official sources 4 times a day (UTC): 00:00, 06:00, 12:00, 18:00
  "triggers": {
    "crons": ["0 0,6,12,18 * * *"]
  },
  // Patch notes store (KV). Already connected.
  "kv_namespaces": [
    { "binding": "PATCHES", "id": "cfcb4f25515f47e4a0a5d3b9f2976c5c" }
  ]

  // ACCOUNTS (see ACCOUNTS-SETUP.md): after you create the D1 database, remove the two slashes at the start of each line below and paste its id.
  ,"d1_databases": [
  { "binding": "DB", "database_name": "nomads-dmz", "database_id": "9413be09-4616-4b33-b43a-3c62485e2d21" }
]
}
